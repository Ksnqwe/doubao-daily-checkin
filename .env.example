# ============================================================
# 豆包每日签到 · 本地配置文件示例
# 复制本文件为 .env 后填写（.env 已被 .gitignore 排除，不会上传）
# ============================================================

# ---------- 必填 ----------
# 浏览器里豆包的完整 Cookie（务必带引号，Cookie 里有分号和等号）
DOUBAO_COOKIE="粘贴你的完整 Cookie"
# 抓包拿到的签到接口地址
DOUBAO_CHECKIN_URL="https://www.doubao.com/xxx/api/xxx/checkin"

# ---------- 请求参数（按抓包结果填写）----------
DOUBAO_CHECKIN_METHOD=POST
# 请求体，必须是合法 JSON；GET 请求可留空
DOUBAO_CHECKIN_BODY={}
# 额外请求头，JSON 对象格式，接口要求 X-Csrf-Token、Referer 等时填这里
DOUBAO_EXTRA_HEADERS={}

# ---------- 结果判定（接口改版时改这里，不用改代码）----------
# 命中任意一个关键词即认为成功
# DOUBAO_SUCCESS_KEYWORDS=签到成功,领取成功,success
# 命中即认为今天已经签过了（会被当作成功，不再重试）
# DOUBAO_ALREADY_KEYWORDS=已签到,重复签到,already
# 精准判定：响应 JSON 中某字段等于某值时算成功，多条用逗号分隔
# DOUBAO_SUCCESS_JSON_PATH=data.checkin_status=1,code=0

# ---------- 通知（可选，多个用英文逗号分隔）----------
# 支持：serverchan, wecom, telegram, bark, webhook
# DOUBAO_NOTIFY=serverchan,wecom
# DOUBAO_NOTIFY_ON_ALREADY=0

# SERVERCHAN_KEY=SCTxxxxxxxxxxxxxxxx
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789
# BARK_URL=https://api.day.app/yourkey
# CUSTOM_WEBHOOK=https://example.com/hook

# ---------- 调试 ----------
# DOUBAO_DEBUG=1
